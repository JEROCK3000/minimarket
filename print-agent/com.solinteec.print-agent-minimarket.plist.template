<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.solinteec.print-agent-minimarket</string>

    <key>ProgramArguments</key>
    <array>
        <string>__RUTA_PYTHON3__</string>
        <string>__RUTA_AGENTE__/print-agent.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/print-agent-minimarket.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/print-agent-minimarket.log</string>
</dict>
</plist>
