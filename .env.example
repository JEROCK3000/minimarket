# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Solinteec Starter
# Copia este archivo a .env y a .env.local, y completa los valores.
# NUNCA commitees .env ni .env.local (ya están en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos (SOLO MySQL o MariaDB — PostgreSQL está prohibido, ver AGENTS.md)
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/nombre_base"

# ─── Secretos obligatorios (la app NO arranca sin ellos) ─────────────────────
# JWT_SECRET: mínimo 32 caracteres. Generar con:  openssl rand -hex 48
JWT_SECRET=""

# ENCRYPTION_KEY: exactamente 64 caracteres hex (para cifrar secretos en BD).
# Generar con:  openssl rand -hex 32
# ⚠️ Respáldala en un gestor de contraseñas. Si se pierde, los secretos cifrados
#    en la base de datos no se podrán descifrar.
ENCRYPTION_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Solinteec App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Seed (opcional) ─────────────────────────────────────────────────────────
# Contraseña del usuario superadmin inicial. Si se omite, el seed genera una
# aleatoria y la muestra una sola vez en consola.
SEED_ADMIN_PASSWORD=""

# ─── SMTP (opcional, si el proyecto envía correos) ───────────────────────────
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
SMTP_FROM=""
# Solo para servidores SMTP internos con certificado inválido (no usar en general):
# SMTP_ALLOW_INVALID_CERTS="false"
