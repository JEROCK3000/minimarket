// ─────────────────────────────────────────────────────────────────────────────
// MiniMarket — Schema (multitenant, base MySQL/MariaDB)
// Base del starter Solinteec + módulos de negocio del minimarket.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  NÚCLEO (heredado del starter): tenants, usuarios, roles, config, logs
// ═══════════════════════════════════════════════════════════════════════════

model Tenant {
  id               String           @id @default(cuid())
  nombre           String           @db.VarChar(150) // nombre del minimarket
  slug             String           @unique @db.VarChar(80)
  activo           Boolean          @default(true)
  // ── SaaS (arquitectura de SmartianERP) ──
  ruc              String?          @db.VarChar(13)
  emailContacto    String?          @db.VarChar(150)
  telefono         String?          @db.VarChar(20)
  planId           String?
  plan             PlanSuscripcion? @relation(fields: [planId], references: [id])
  // PRUEBA | ACTIVO | CANCELADO. GRACIA y SUSPENDIDO NO se guardan: se calculan
  // con fechaExpiracion (lib/saas/suscripcion.ts), sin depender de un cron.
  estado           String           @default("ACTIVO") @db.VarChar(12)
  suspendidoManual Boolean          @default(false) // suspensión decidida por el superadmin
  cicloFacturacion String           @default("MENSUAL") @db.VarChar(10) // MENSUAL | ANUAL
  fechaExpiracion  DateTime? // NULL = sin vencimiento (cortesía / cliente antiguo)
  notasAdmin       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  usuarios         Usuario[]
  categorias       Categoria[]
  productos        Producto[]
  proveedores      Proveedor[]
  clientes         Cliente[]
  compras          Compra[]
  ventas           Venta[]
  gastos           Gasto[]
  movimientos      MovimientoInventario[]
  pagosSuscripcion PagoSuscripcion[]

  @@map("tenants")
}

// ═══════════════════════════════════════════════════════════════════════════
//  SAAS: planes, pagos de suscripción y solicitudes de registro (SmartianERP)
// ═══════════════════════════════════════════════════════════════════════════
model PlanSuscripcion {
  id             String   @id @default(cuid())
  codigo         String   @unique @db.VarChar(50) // inmutable tras crearse
  nombre         String   @db.VarChar(100)
  descripcion    String?  @db.Text
  precioMensual  Decimal  @default(0) @db.Decimal(10, 2)
  precioAnual    Decimal  @default(0) @db.Decimal(10, 2)
  maxUsuarios    Int? // NULL = ilimitado
  maxProductos   Int?
  maxFacturasMes Int?
  diasPrueba     Int      @default(0)
  activo         Boolean  @default(true) // inactivo: no se ofrece a nuevos registros
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenants     Tenant[]
  solicitudes SolicitudRegistro[]

  @@map("planes_suscripcion")
}

model PagoSuscripcion {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  superadminId String?
  tipo         String   @db.VarChar(30) // TRANSFERENCIA | EFECTIVO | TARJETA | CORTESIA
  monto        Decimal  @db.Decimal(10, 2)
  referencia   String?  @db.VarChar(200)
  periodoDesde DateTime
  periodoHasta DateTime
  notas        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("pagos_suscripcion")
}

model SolicitudRegistro {
  id                String          @id @default(cuid())
  // Token para que el solicitante vuelva a subir el comprobante (solo se guarda su hash SHA-256)
  tokenHash         String          @unique @db.VarChar(64)
  nombreNegocio     String          @db.VarChar(150)
  ruc               String          @db.VarChar(13)
  direccion         String?         @db.VarChar(300)
  telefono          String?         @db.VarChar(20)
  emailContacto     String          @db.VarChar(150)
  planId            String
  plan              PlanSuscripcion @relation(fields: [planId], references: [id])
  cicloFacturacion  String          @default("MENSUAL") @db.VarChar(10)
  adminNombre       String          @db.VarChar(120)
  adminEmail        String          @db.VarChar(180)
  adminPasswordHash String          @db.VarChar(255) // bcrypt; nunca en claro
  estado            String          @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | PAGO_VERIFICADO | APROBADO | RECHAZADO
  comprobantePath   String?         @db.VarChar(255)
  comprobanteAt     DateTime?
  motivoRechazo     String?         @db.VarChar(300)
  ip                String?         @db.VarChar(64)
  userAgent         String?         @db.VarChar(255)
  tenantId          String? // creado al aprobar
  revisadoPor       String?         @db.VarChar(180)
  revisadoAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([estado])
  @@map("solicitudes_registro")
}

model Usuario {
  id       String  @id @default(cuid())
  tenantId String? // null solo para SUPERADMIN global
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre   String  @db.VarChar(120)
  email    String  @db.VarChar(180)
  password String  @db.VarChar(255) // solo hash bcrypt
  rol      Rol     @default(USER)
  activo   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas             Venta[] // ventas realizadas por este usuario (cajero)
  tokensRecuperacion TokenRecuperacion[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("usuarios")
}

/// Tokens de un solo uso para restablecer contraseña desde el login.
/// Se guarda solo el hash SHA-256 del token; el token real viaja únicamente en el correo.
model TokenRecuperacion {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @db.VarChar(64)
  expiraEn  DateTime
  usadoEn   DateTime?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

enum Rol {
  SUPERADMIN // Solinteec: orquesta todos los minimarkets
  ADMIN // dueño del minimarket
  USER // cajero / empleado
}

model Config {
  id        String   @id @default(cuid())
  tenantId  String?
  clave     String   @db.VarChar(100)
  valor     String   @db.Text // secretos van cifrados (lib/security/crypto)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clave])
  @@map("config")
}

model Log {
  id        String   @id @default(cuid())
  tenantId  String?
  nivel     NivelLog
  modulo    String   @db.VarChar(60)
  mensaje   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([nivel])
  @@index([createdAt])
  @@map("logs")
}

enum NivelLog {
  INFO
  WARN
  ERROR
  SECURITY
  AUDIT
  DEBUG
}

// ═══════════════════════════════════════════════════════════════════════════
//  INVENTARIO: categorías y productos
// ═══════════════════════════════════════════════════════════════════════════

model Categoria {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre    String   @db.VarChar(100)
  icono     String?  @db.VarChar(20)
  color     String?  @db.VarChar(20)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos Producto[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("categorias")
}

model Producto {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  codigoBarras String? @db.VarChar(50) // para el lector del POS
  nombre       String  @db.VarChar(150)
  descripcion  String? @db.Text
  imagen       String? @db.VarChar(120) // archivo WebP en storage/productos/<tenantId>/ (ver lib/productos/imagenes.ts)

  // Precios
  precioCompra  Decimal @default(0) @db.Decimal(10, 4)
  precioVenta   Decimal @default(0) @db.Decimal(10, 4)
  ivaPorcentaje Decimal @default(15) @db.Decimal(5, 2) // 15 (IVA) o 0 (exento)

  // Inventario
  stock       Decimal @default(0) @db.Decimal(10, 3) // decimal: permite venta por peso
  stockMinimo Decimal @default(0) @db.Decimal(10, 3) // para alertas de reposición
  unidad      String  @default("unidad") @db.VarChar(20) // unidad, kg, lb, litro...
  vendible    Boolean @default(true)
  activo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compraItems      CompraItem[]
  ventaItems       VentaItem[]
  codigosProveedor ProductoCodigoProveedor[]
  tomaItems        TomaInventarioItem[]
  movimientos      MovimientoInventario[]

  @@unique([tenantId, codigoBarras])
  @@index([tenantId])
  @@index([categoriaId])
  @@map("productos")
}

// Kardex: cada entrada/salida de stock queda registrada para trazabilidad
model MovimientoInventario {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  tipo          TipoMovimiento
  cantidad      Decimal        @db.Decimal(10, 3) // + entra, - sale
  stockPrevio   Decimal        @db.Decimal(10, 3)
  stockNuevo    Decimal        @db.Decimal(10, 3)
  motivo        String?        @db.VarChar(200) // "Compra #12", "Venta #340", "Ajuste manual"
  categoria     String?        @db.VarChar(20) // pérdidas: VENCIDO | DANADO | CONSUMO | ROBO | FALTANTE | OTRO (lib/inventario/mermas.ts)
  costoUnitario Decimal?       @db.Decimal(10, 4) // costo del producto al momento del movimiento (valoriza mermas)
  usuarioNombre String?        @db.VarChar(120) // quién lo registró (ajustes, mermas, tomas)
  createdAt     DateTime       @default(now())

  @@index([tenantId])
  @@index([productoId])
  @@index([tenantId, tipo, createdAt])
  @@map("movimientos_inventario")
}

enum TipoMovimiento {
  COMPRA
  VENTA
  AJUSTE
  MERMA // producto dañado/vencido
}

// ═══════════════════════════════════════════════════════════════════════════
//  COMPRAS (entrada de mercadería)
// ═══════════════════════════════════════════════════════════════════════════

model Proveedor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre         String   @db.VarChar(150)
  identificacion String?  @db.VarChar(15) // RUC/cédula
  telefono       String?  @db.VarChar(20)
  email          String?  @db.VarChar(150)
  direccion      String?  @db.VarChar(300)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  compras Compra[]

  @@index([tenantId])
  @@map("proveedores")
}

model Compra {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  numero          String    @db.VarChar(30) // correlativo interno
  numFactura      String?   @db.VarChar(40) // nº factura del proveedor
  claveAcceso     String?   @db.VarChar(49) // si se cargó desde el XML/SRI: evita registrar la misma factura dos veces
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  iva             Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  notas           String?   @db.Text
  estado          String    @default("ACTIVA") @db.VarChar(10) // ACTIVA | ANULADA
  condicionPago   String    @default("CONTADO") @db.VarChar(10) // CONTADO | CREDITO (a pagar al proveedor)
  saldoPendiente  Decimal   @default(0) @db.Decimal(12, 2) // crédito: lo que falta pagar al proveedor
  venceEl         DateTime? // crédito: fecha límite de pago
  anuladaAt       DateTime?
  motivoAnulacion String?   @db.VarChar(300)
  fecha           DateTime  @default(now())
  createdAt       DateTime  @default(now())

  items CompraItem[]
  pagos PagoCompra[]

  @@unique([tenantId, claveAcceso])
  @@index([tenantId])
  @@map("compras")
}

// Pago a proveedor de una compra a crédito (cuentas por pagar). Descuenta
// Compra.saldoPendiente de forma atómica; el efectivo sale de la caja.
model PagoCompra {
  id            String   @id @default(cuid())
  tenantId      String
  compraId      String
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  proveedorId   String?
  monto         Decimal  @db.Decimal(12, 2)
  formaPago     String   @db.VarChar(20) // EFECTIVO, TRANSFERENCIA, TARJETA, CHEQUE
  notas         String?  @db.VarChar(200)
  usuarioId     String?
  usuarioNombre String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([compraId])
  @@map("pagos_compra")
}

model CompraItem {
  id         String   @id @default(cuid())
  compraId   String
  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad         Decimal   @db.Decimal(10, 3)
  precioUnitario   Decimal   @db.Decimal(10, 4)
  subtotal         Decimal   @db.Decimal(12, 2)
  fechaVencimiento DateTime? @db.Date // opcional: vencimiento del lote comprado

  @@index([compraId])
  @@map("compra_items")
}

// ═══════════════════════════════════════════════════════════════════════════
//  VENTAS (POS) y clientes
// ═══════════════════════════════════════════════════════════════════════════

model Cliente {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tipoIdentificacion String   @default("CONSUMIDOR_FINAL") @db.VarChar(20) // CEDULA/RUC/PASAPORTE/CONSUMIDOR_FINAL
  identificacion     String   @db.VarChar(15)
  nombre             String   @db.VarChar(200)
  telefono           String?  @db.VarChar(20)
  email              String?  @db.VarChar(150)
  direccion          String?  @db.VarChar(300)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ventas Venta[]

  @@unique([tenantId, identificacion])
  @@index([tenantId])
  @@map("clientes")
}

model Venta {
  id                          String   @id @default(cuid())
  tenantId                    String
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId                   String?
  cliente                     Cliente? @relation(fields: [clienteId], references: [id])
  // Identificación con que se emitió (congelada al vender; ver src/lib/ventas/comprador.ts)
  tipoIdentificacionComprador String?  @db.VarChar(20)
  identificacionComprador     String?  @db.VarChar(15)
  usuarioId                   String? // cajero que hizo la venta
  usuario                     Usuario? @relation(fields: [usuarioId], references: [id])

  numero          String      @db.VarChar(30)
  formaPago       String      @default("EFECTIVO") @db.VarChar(20) // EFECTIVO, TARJETA, TRANSFERENCIA, CREDITO (fiado)
  saldoPendiente  Decimal     @default(0) @db.Decimal(12, 2) // fiado: lo que falta cobrar (0 si se pagó al contado)
  diasCredito     Int? // fiado: plazo en días (va a la factura SRI)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  descuento       Decimal     @default(0) @db.Decimal(12, 2)
  iva             Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @default(0) @db.Decimal(12, 2)
  pagoCon         Decimal?    @db.Decimal(12, 2) // con cuánto pagó (para el vuelto)
  requiereFactura Boolean     @default(true) // true = factura electrónica; false = solo ticket
  estado          EstadoVenta @default(COMPLETADA)
  fecha           DateTime    @default(now())
  createdAt       DateTime    @default(now())

  totalDevuelto Decimal @default(0) @db.Decimal(12, 2) // suma de devoluciones parciales

  items        VentaItem[]
  factura      FacturaSRI?
  notasCredito NotaCredito[]
  devoluciones Devolucion[]
  abonos       AbonoVenta[]

  @@index([tenantId])
  @@index([clienteId])
  @@map("ventas")
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

// Abono (pago parcial o total) a una venta a crédito (fiado). Un cobro del
// cliente se reparte en abonos a sus ventas pendientes, de la más antigua a la
// más nueva; cada abono descuenta Venta.saldoPendiente de forma atómica.
model AbonoVenta {
  id            String   @id @default(cuid())
  tenantId      String
  ventaId       String
  venta         Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  clienteId     String
  monto         Decimal  @db.Decimal(12, 2)
  formaPago     String   @db.VarChar(20) // EFECTIVO, TARJETA, TRANSFERENCIA
  notas         String?  @db.VarChar(200)
  usuarioId     String?
  usuarioNombre String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([ventaId])
  @@index([clienteId])
  @@map("abonos_venta")
}

model VentaItem {
  id         String   @id @default(cuid())
  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad       Decimal  @db.Decimal(10, 3)
  precioUnitario Decimal  @db.Decimal(10, 4)
  subtotal       Decimal  @db.Decimal(12, 2)
  costoUnitario  Decimal? @db.Decimal(10, 4) // precio de compra al vender (utilidad real); NULL en ventas antiguas

  devolucionItems DevolucionItem[]

  @@index([ventaId])
  @@map("venta_items")
}

// ═══════════════════════════════════════════════════════════════════════════
//  GASTOS
// ═══════════════════════════════════════════════════════════════════════════

model Gasto {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoria   String   @db.VarChar(60) // Arriendo, Servicios, Sueldos, Transporte...
  descripcion String   @db.VarChar(300)
  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("gastos")
}

// ═══════════════════════════════════════════════════════════════════════════
//  CIERRE DE CAJA
// ═══════════════════════════════════════════════════════════════════════════

model CierreCaja {
  id            String  @id @default(cuid())
  tenantId      String
  usuarioId     String?
  usuarioNombre String? @db.VarChar(120)

  desde                  DateTime // inicio del período del corte
  fondoInicial           Decimal  @default(0) @db.Decimal(12, 2) // efectivo con el que se abrió la caja
  hasta                  DateTime // fin del período (momento del cierre)
  totalVentas            Int      @default(0)
  ventasEfectivo         Decimal  @default(0) @db.Decimal(12, 2)
  ventasTarjeta          Decimal  @default(0) @db.Decimal(12, 2)
  ventasTransfer         Decimal  @default(0) @db.Decimal(12, 2)
  totalVendido           Decimal  @default(0) @db.Decimal(12, 2)
  gastosEfectivo         Decimal  @default(0) @db.Decimal(12, 2)
  abonosEfectivo         Decimal  @default(0) @db.Decimal(12, 2) // cobros de fiado recibidos en efectivo
  pagosProveedorEfectivo Decimal  @default(0) @db.Decimal(12, 2) // pagos a proveedores en efectivo (salen de caja)
  ingresosEfectivo       Decimal  @default(0) @db.Decimal(12, 2) // ingresos de efectivo durante el turno (cambio adicional…)
  retirosEfectivo        Decimal  @default(0) @db.Decimal(12, 2) // retiros de efectivo durante el turno (a caja fuerte, al dueño…)
  devolucionesEfectivo   Decimal  @default(0) @db.Decimal(12, 2) // dinero devuelto a clientes en efectivo
  efectivoEsperado       Decimal  @default(0) @db.Decimal(12, 2) // fondo + efectivo ventas + abonos efectivo − gastos
  efectivoContado        Decimal  @default(0) @db.Decimal(12, 2) // lo que contó físicamente
  diferencia             Decimal  @default(0) @db.Decimal(12, 2) // contado − esperado
  notas                  String?  @db.Text
  createdAt              DateTime @default(now())

  @@index([tenantId])
  @@map("cierres_caja")
}

// Apertura de caja: fondo inicial en efectivo. El cierre siguiente la cierra
// (cerradaAt) y toma su fecha como inicio del período. Sin relación a Tenant,
// igual que CierreCaja (se filtra por tenantId en todas las consultas).
model AperturaCaja {
  id            String    @id @default(cuid())
  tenantId      String
  usuarioId     String?
  usuarioNombre String?   @db.VarChar(120)
  fondoInicial  Decimal   @default(0) @db.Decimal(12, 2)
  notas         String?   @db.VarChar(300)
  abiertaAt     DateTime  @default(now())
  cerradaAt     DateTime?

  @@index([tenantId, cerradaAt])
  @@map("aperturas_caja")
}

// ═══════════════════════════════════════════════════════════════════════════
//  FACTURACIÓN ELECTRÓNICA SRI (a portar/adaptar desde GABLIMADOS)
// ═══════════════════════════════════════════════════════════════════════════

model EmisorSRI {
  id                    String   @id @default(cuid())
  tenantId              String   @unique // un emisor por minimarket
  ruc                   String   @db.VarChar(13)
  razonSocial           String   @db.VarChar(300)
  nombreComercial       String?  @db.VarChar(300)
  dirMatriz             String   @db.VarChar(300)
  dirEstablecimiento    String   @db.VarChar(300)
  codigoEstablecimiento String   @default("001") @db.VarChar(3)
  codigoPuntoEmision    String   @default("001") @db.VarChar(3)
  obligadoContabilidad  Boolean  @default(false)
  ambiente              Int      @default(1) // 1=pruebas, 2=producción
  passwordFirma         String   @db.VarChar(500) // CIFRADO (lib/security/crypto)
  rutaFirma             String   @db.VarChar(500)
  logoPath              String?  @db.VarChar(500) // ruta del logo para el RIDE
  contribuyenteEspecial String?  @db.VarChar(20)
  agenteRetencion       String?  @db.VarChar(20)
  secuencialFactura     Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("emisor_sri")
}

model FacturaSRI {
  id       String @id @default(cuid())
  tenantId String
  ventaId  String @unique
  venta    Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  claveAcceso        String    @db.VarChar(49)
  numeroAutorizacion String?   @db.VarChar(49)
  estado             String    @default("PENDIENTE") @db.VarChar(20) // PENDIENTE/AUTORIZADA/RECHAZADA
  xmlFirmado         String?   @db.LongText
  mensajeError       String?   @db.Text
  fechaAutorizacion  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@map("facturas_sri")
}

// Nota de crédito: anula/modifica una factura ya autorizada por el SRI (codDoc 04)
model NotaCredito {
  id              String  @id @default(cuid())
  tenantId        String
  ventaId         String // factura/venta que modifica (puede tener varias NC parciales)
  venta           Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  tipo            String  @default("TOTAL") @db.VarChar(10) // TOTAL (anula la factura) | PARCIAL (devolución)
  // NC parcial autorizada: la devolución que respalda
  devolucionId    String? @unique
  // NC parcial que quedó PENDIENTE en el SRI: lo pedido, para aplicarlo al autorizarse
  datosPendientes Json?

  claveAcceso        String    @db.VarChar(49)
  numeroAutorizacion String?   @db.VarChar(49)
  estado             String    @default("PENDIENTE") @db.VarChar(20) // PENDIENTE/AUTORIZADA/RECHAZADA
  motivo             String    @db.VarChar(300)
  valorModificacion  Decimal   @db.Decimal(12, 2)
  xmlFirmado         String?   @db.LongText
  mensajeError       String?   @db.Text
  fechaAutorizacion  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([ventaId])
  @@map("notas_credito")
}

/// Equivalencia aprendida al cargar facturas XML: el código que usa un proveedor
/// (por RUC) para un artículo → el producto del minimarket y cuántas unidades
/// trae cada empaque (p. ej. "CAJA x24" → factor 24).
model ProductoCodigoProveedor {
  id           String   @id @default(cuid())
  tenantId     String
  proveedorRuc String   @db.VarChar(13)
  codigo       String   @db.VarChar(50)
  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  factor       Decimal  @default(1) @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, proveedorRuc, codigo])
  @@index([productoId])
  @@map("productos_codigos_proveedor")
}

/// Toma de inventario físico: se cuentan los productos (todos o una categoría)
/// y al aplicarla se ajusta la diferencia de cada uno con kardex.
model TomaInventario {
  id              String    @id @default(cuid())
  tenantId        String
  numero          String    @db.VarChar(20) // TI-00001
  categoriaId     String? // alcance: null = todos los productos
  categoriaNombre String?   @db.VarChar(100)
  estado          String    @default("EN_CURSO") @db.VarChar(12) // EN_CURSO | APLICADA | CANCELADA
  notas           String?   @db.VarChar(300)
  creadaPor       String    @db.VarChar(120)
  aplicadaPor     String?   @db.VarChar(120)
  aplicadaAt      DateTime?
  valorFaltante   Decimal   @default(0) @db.Decimal(12, 2) // a costo, al aplicar
  valorSobrante   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items TomaInventarioItem[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@map("tomas_inventario")
}

model TomaInventarioItem {
  id              String         @id @default(cuid())
  tomaId          String
  toma            TomaInventario @relation(fields: [tomaId], references: [id], onDelete: Cascade)
  productoId      String
  producto        Producto       @relation(fields: [productoId], references: [id])
  cantidadContada Decimal        @db.Decimal(10, 3)
  // Stock del sistema cuando se registró el conteo: al aplicar se ajusta
  // (contado − stockAlContar), así las ventas posteriores al conteo se respetan.
  stockAlContar   Decimal        @db.Decimal(10, 3)
  contadoPor      String         @db.VarChar(120)
  contadoAt       DateTime       @default(now())

  @@unique([tomaId, productoId])
  @@index([productoId])
  @@map("tomas_inventario_items")
}

/// Retiros e ingresos de efectivo durante el turno (no son ventas ni gastos):
/// llevar billetes a la caja fuerte, entregar al dueño, traer cambio. Entran al
/// cuadre del cierre. No se borran: un error se corrige con el movimiento contrario.
model MovimientoCaja {
  id            String   @id @default(cuid())
  tenantId      String
  aperturaId    String?
  tipo          String   @db.VarChar(10) // RETIRO | INGRESO
  monto         Decimal  @db.Decimal(12, 2)
  motivo        String   @db.VarChar(200)
  usuarioId     String?
  usuarioNombre String   @db.VarChar(120)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("movimientos_caja")
}

/// Devolución parcial de una venta (DEV-00001): ticket o factura. En facturas
/// autorizadas la respalda una NotaCredito parcial (NotaCredito.devolucionId).
model Devolucion {
  id             String   @id @default(cuid())
  tenantId       String
  ventaId        String
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  numero         String   @db.VarChar(20)
  motivo         String   @db.VarChar(300)
  subtotal       Decimal  @db.Decimal(12, 2) // antes de descuento
  descuento      Decimal  @db.Decimal(12, 2)
  iva            Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  formaReembolso String   @db.VarChar(20) // EFECTIVO | TARJETA | TRANSFERENCIA | SALDO (descuenta del fiado)
  reingresaStock Boolean  @default(true) // false: el producto volvió dañado (queda como merma)
  usuarioNombre  String   @db.VarChar(120)
  createdAt      DateTime @default(now())

  items DevolucionItem[]

  @@unique([tenantId, numero])
  @@index([tenantId, createdAt])
  @@index([ventaId])
  @@map("devoluciones")
}

model DevolucionItem {
  id             String     @id @default(cuid())
  devolucionId   String
  devolucion     Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItemId    String
  ventaItem      VentaItem  @relation(fields: [ventaItemId], references: [id])
  productoId     String
  cantidad       Decimal    @db.Decimal(10, 3)
  precioUnitario Decimal    @db.Decimal(10, 4)
  descuento      Decimal    @db.Decimal(12, 2)
  base           Decimal    @db.Decimal(12, 2)
  ivaPorcentaje  Decimal    @db.Decimal(5, 2)
  iva            Decimal    @db.Decimal(12, 2)

  @@index([devolucionId])
  @@index([ventaItemId])
  @@map("devolucion_items")
}
